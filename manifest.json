{
  "manifest_version": 3,
  "name": "ESPN Autoplay Blocker",
  "version": "1.0.0",
  "description": "Stops videos on ESPN from playing until you click them.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.espn.com/*",
        "*://*.espn.co.uk/*",
        "*://*.espn.in/*",
        "*://*.espn.com.au/*",
        "*://*.espn.com.br/*",
        "*://*.espn.com.mx/*",
        "*://*.espn.com.ar/*",
        "*://*.espn.nl/*",
        "*://*.espn.ph/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
